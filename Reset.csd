/* CSS RESET - Baseado no modelo de Eric Meyer */
/* Serve para zerar as diferenças de estilo entre navegadores */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, div, h1, h2, p, img, a, section, header, footer {
  margin: 0;
  padding: 0;
  border: 0;
  font-size: 100%;
  vertical-align: baseline;
}
